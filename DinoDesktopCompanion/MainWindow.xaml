<Window x:Class="DinoDesktopCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DinoDesktopCompanion.UI"
        Title="Dino Desktop Companion" Width="300" Height="285"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid>
        <Border x:Name="SpeechBubble" HorizontalAlignment="Center" VerticalAlignment="Top"
                MaxWidth="270" Padding="14,10" CornerRadius="15" Background="{StaticResource DinoSurface}"
                BorderBrush="{StaticResource DinoAccent}" BorderThickness="2" Visibility="Collapsed">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#173A32"/></Border.Effect>
            <TextBlock x:Name="SpeechText" Foreground="{StaticResource DinoText}" FontSize="14" TextWrapping="Wrap"/>
        </Border>
        <ui:DinoVisual x:Name="Dino" Width="230" Height="185" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       MouseLeftButtonDown="Dino_MouseLeftButtonDown" MouseRightButtonUp="Dino_MouseRightButtonUp"
                       MouseMove="Dino_MouseMove" MouseLeftButtonUp="Dino_MouseLeftButtonUp">
        </ui:DinoVisual>
        <TextBlock x:Name="PetHeart" Text="♥" FontSize="48" FontWeight="Bold" Foreground="#F05A78"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="118,0,0,150"
                   Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect Color="#FFFFFFFF" BlurRadius="5" ShadowDepth="0" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
