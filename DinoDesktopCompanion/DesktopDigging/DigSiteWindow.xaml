<Window x:Class="DinoDesktopCompanion.DesktopDigging.DigSiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="210" Height="150" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="102"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <Grid x:Name="DigVisualContainer" Grid.Row="0" Height="102" Margin="4,0" RenderTransformOrigin="0.5,0.75">
            <Image x:Name="DigSiteImage" Width="194" Height="100" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
        </Grid>
        <Border x:Name="StatusPanel" Grid.Row="1" Margin="2,1" Background="#E6FFFFFF"
                BorderBrush="#AFCFC3" BorderThickness="1" CornerRadius="9" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,5,0">
                    <TextBlock x:Name="DigLabel" Text="Garten · 0/15" Foreground="#203A35"
                               FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="DigProgress" Height="5" Minimum="0" Maximum="15" Value="0"
                                 Margin="0,3,0,0" Foreground="#3B9A78" Background="#DDE9E4" BorderThickness="0"/>
                </StackPanel>
                <Button x:Name="DigButton" Grid.Column="1" Content="Dino rufen" Click="DigButton_Click"
                        Width="67" Height="25" Padding="3,0" MinWidth="0" MinHeight="0" Focusable="False"
                        Cursor="Hand" ToolTip="Grabungsstelle"/>
                <Button Grid.Column="2" Content="×" Click="CloseButton_Click" Width="24" Height="25"
                        Margin="4,0,0,0" Padding="0" MinWidth="0" MinHeight="0" Focusable="False"
                        ToolTip="Grabung schließen"/>
            </Grid>
        </Border>
        
        <Border x:Name="FoundItemOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#F5FFFFFF"
                BorderBrush="#FFD700" BorderThickness="2" CornerRadius="12" Margin="10,20"
                Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Fund entdeckt!" FontWeight="Bold" FontSize="11" Foreground="#8B6914" HorizontalAlignment="Center"/>
                <Image x:Name="FoundItemImage" Width="48" Height="48" Margin="0,5" Stretch="Uniform"/>
                <TextBlock x:Name="FoundItemName" Text="Item Name" FontSize="11" FontWeight="SemiBold" Foreground="#333" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" TextAlignment="Center"/>
                <TextBlock x:Name="FoundItemRarity" Text="Seltenheit" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
