<Window x:Class="DinoDesktopCompanion.DesktopDigging.DigSiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="210" Height="150" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="102"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
          <Grid x:Name="DigVisualContainer" Grid.Row="0" Height="102" Margin="4,0" RenderTransformOrigin="0.5,0.75">
                  <Ellipse Width="166" Height="25" VerticalAlignment="Bottom" Margin="0,0,0,4"
                         Fill="#30251F" Opacity="0.22"/>
                  <Ellipse x:Name="GroundBase" Width="156" Height="64" VerticalAlignment="Bottom" Margin="0,0,0,12"
                         Fill="#765238" Stroke="#4F392B" StrokeThickness="2"/>
                  <Ellipse x:Name="GroundTop" Width="132" Height="48" VerticalAlignment="Bottom" Margin="0,0,0,40"
                         Fill="#A2764B" Stroke="#63452E" StrokeThickness="2"/>
                  <Path x:Name="DirtHighlight" Data="M 34,67 C 58,53 78,64 100,54 C 119,45 141,51 159,61"
                      Stroke="#C0925D" StrokeThickness="4" Opacity="0.7" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Fill="Transparent"/>
                    <Ellipse x:Name="AccentLeft" Width="54" Height="21" Fill="#5E8E49" HorizontalAlignment="Left"
                             VerticalAlignment="Bottom" Margin="17,0,0,48" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="-12"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="AccentRight" Width="68" Height="24" Fill="#6FA354" HorizontalAlignment="Right"
                             VerticalAlignment="Bottom" Margin="0,0,21,43" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="9"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Path x:Name="RootLine" Data="M 29,73 C 51,48 75,83 101,53 C 119,34 139,50 148,43"
                          Stroke="#5C422D" StrokeThickness="6" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Fill="Transparent"/>
                    <Ellipse x:Name="Hole" Width="88" Height="22" VerticalAlignment="Bottom" Margin="0,0,0,31"
                             Fill="#30231E" Stroke="#54392A" StrokeThickness="2"/>
                    <StackPanel x:Name="StoneDecor" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" Margin="0,0,0,49">
                        <Polygon Points="0,12 7,0 16,10" Fill="#8A8177" Stroke="#5E574F" StrokeThickness="1" Margin="3,0"/>
                        <Polygon Points="0,10 8,0 18,11" Fill="#A29A8E" Stroke="#665F57" StrokeThickness="1" Margin="3,0"/>
                        <Polygon Points="0,11 7,1 15,11" Fill="#766E67" Stroke="#514B45" StrokeThickness="1" Margin="3,0"/>
                    </StackPanel>
                    <StackPanel x:Name="CrystalDecor" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" Margin="0,0,0,48" Visibility="Collapsed">
                        <Polygon Points="0,15 8,0 15,15" Fill="#B9A7FF" Stroke="#6B55B5" StrokeThickness="1" Margin="3,0"/>
                        <Polygon Points="0,15 6,4 13,15" Fill="#7DE2E8" Stroke="#347E8A" StrokeThickness="1" Margin="3,0"/>
                        <Polygon Points="0,15 9,2 17,15" Fill="#D4C8FF" Stroke="#8067C2" StrokeThickness="1" Margin="3,0"/>
                    </StackPanel>
                    <TextBlock x:Name="DecorationLeft" Text="🍂" FontSize="21" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,18"/>
                    <TextBlock x:Name="DecorationRight" Text="🍃" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,22"/>
                    <TextBlock Text="✦" FontSize="18" Foreground="#FFE69B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,35,0"/>
                    <TextBlock Text="·" FontSize="28" Foreground="#FFF1B5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="32,0,0,0"/>
        </Grid>
        <Border x:Name="StatusPanel" Grid.Row="1" Margin="2,1" Background="#E6FFFFFF"
                BorderBrush="#AFCFC3" BorderThickness="1" CornerRadius="9" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,5,0">
                    <TextBlock x:Name="DigLabel" Text="Garten · 0/15" Foreground="#203A35"
                               FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="DigProgress" Height="5" Minimum="0" Maximum="15" Value="0"
                                 Margin="0,3,0,0" Foreground="#3B9A78" Background="#DDE9E4" BorderThickness="0"/>
                </StackPanel>
                <Button x:Name="DigButton" Grid.Column="1" Content="Dino rufen" Click="DigButton_Click"
                        Width="67" Height="25" Padding="3,0" MinWidth="0" MinHeight="0" Focusable="False"
                        Cursor="Hand" ToolTip="Grabungsstelle"/>
                <Button Grid.Column="2" Content="×" Click="CloseButton_Click" Width="24" Height="25"
                        Margin="4,0,0,0" Padding="0" MinWidth="0" MinHeight="0" Focusable="False"
                        ToolTip="Grabung schließen"/>
            </Grid>
        </Border>
        
        <Border x:Name="FoundItemOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#F5FFFFFF"
                BorderBrush="#FFD700" BorderThickness="2" CornerRadius="12" Margin="10,20"
                Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Fund entdeckt!" FontWeight="Bold" FontSize="11" Foreground="#8B6914" HorizontalAlignment="Center"/>
                <Image x:Name="FoundItemImage" Width="48" Height="48" Margin="0,5" Stretch="Uniform"/>
                <TextBlock x:Name="FoundItemName" Text="Item Name" FontSize="11" FontWeight="SemiBold" Foreground="#333" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" TextAlignment="Center"/>
                <TextBlock x:Name="FoundItemRarity" Text="Seltenheit" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
