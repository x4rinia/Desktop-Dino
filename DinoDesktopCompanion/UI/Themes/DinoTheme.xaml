<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="DinoBackgroundColor">#EFF7F4</Color>
    <Color x:Key="DinoSurfaceColor">#FCFFFD</Color>
    <Color x:Key="DinoCardColor">#F7FBF9</Color>
    <Color x:Key="DinoPrimaryColor">#398B7B</Color>
    <Color x:Key="DinoPrimaryDarkColor">#286A5E</Color>
    <Color x:Key="DinoAccentColor">#8DD0BF</Color>
    <Color x:Key="DinoTextColor">#203A35</Color>
    <Color x:Key="DinoMutedTextColor">#637C76</Color>
    <Color x:Key="DinoBorderColor">#D5E5DF</Color>
    <Color x:Key="DinoDangerColor">#BD5B60</Color>

    <SolidColorBrush x:Key="DinoBackground" Color="{StaticResource DinoBackgroundColor}"/>
    <SolidColorBrush x:Key="DinoSurface" Color="{StaticResource DinoSurfaceColor}"/>
    <SolidColorBrush x:Key="DinoCard" Color="{StaticResource DinoCardColor}"/>
    <SolidColorBrush x:Key="DinoPrimary" Color="{StaticResource DinoPrimaryColor}"/>
    <SolidColorBrush x:Key="DinoPrimaryDark" Color="{StaticResource DinoPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="DinoAccent" Color="{StaticResource DinoAccentColor}"/>
    <SolidColorBrush x:Key="DinoText" Color="{StaticResource DinoTextColor}"/>
    <SolidColorBrush x:Key="DinoMutedText" Color="{StaticResource DinoMutedTextColor}"/>
    <SolidColorBrush x:Key="DinoBorder" Color="{StaticResource DinoBorderColor}"/>
    <SolidColorBrush x:Key="DinoDanger" Color="{StaticResource DinoDangerColor}"/>
    <LinearGradientBrush x:Key="DinoHeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DDF3EC" Offset="0"/>
        <GradientStop Color="#C9EBE1" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="DinoWindowShell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DinoSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DinoBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.2" Color="#173A32"/></Setter.Value></Setter>
    </Style>

    <Style x:Key="DinoSectionCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DinoCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DinoBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="DinoTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DinoText}"/>
    </Style>
    <Style x:Key="DinoSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DinoPrimaryDark}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="DinoButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource DinoPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DinoButton}"/>
    <Style x:Key="DinoSecondaryButton" TargetType="Button" BasedOn="{StaticResource DinoButton}">
        <Setter Property="Foreground" Value="{StaticResource DinoText}"/>
        <Setter Property="Background" Value="#E5F1ED"/>
    </Style>
    <Style x:Key="DinoCloseButton" TargetType="Button" BasedOn="{StaticResource DinoButton}">
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource DinoMutedText}"/><Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource DinoText}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource DinoBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource DinoPrimary}"/><Setter TargetName="Field" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource DinoText}"/><Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource DinoBorder}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource DinoText}"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="2,6"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="4,8"/></Style>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="Foreground" Value="{StaticResource DinoText}"/></Style>
</ResourceDictionary>
