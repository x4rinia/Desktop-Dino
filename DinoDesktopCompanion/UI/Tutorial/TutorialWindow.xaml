<Window x:Class="DinoDesktopCompanion.UI.Tutorial.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dino Desktop Companion - Info" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F4F8F7"
        ResizeMode="NoResize" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Willkommen beim Dino!" FontSize="22" FontWeight="Bold" Foreground="#1E3E34" Margin="0,0,0,15"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Dein virtueller Desktop-Gefährte"/>
                <TextBlock Text="Der Dino lebt auf deinem Desktop. Er kann herumwandern, sich ausruhen und kleine Aufgaben erledigen. Klicke ihn doppelt an, um das Dino-Menü zu öffnen."/>
                
                <TextBlock FontWeight="SemiBold" Text="Abenteuerpunkte (AP) &amp; Energie"/>
                <TextBlock Text="Der Dino braucht Energie, um Aufgaben wie Grabungen zu erledigen. Wenn er schläft oder auf dem Desktop aktiv ist, regeneriert er langsam AP. Du siehst seine aktuelle AP im Dino-Menü oder wenn du mit der Maus über den schlafenden Dino auf dem Desktop fährst."/>

                <TextBlock FontWeight="SemiBold" Text="Dino schlafen schicken"/>
                <TextBlock Text="Möchtest du, dass der Dino schneller Energie sammelt oder dich nicht beim Arbeiten stört? Schicke ihn über das Dino-Menü schlafen oder nach Hause ins Dino-Haus. Er bleibt so lange dort, bis du ihn wieder aufweckst."/>
                
                <TextBlock FontWeight="SemiBold" Text="Apfel, Ball &amp; Waschen"/>
                <TextBlock Text="Im Start-Bereich des Dino-Menüs kannst du einen Apfel hinlegen, einen Ball zuwerfen oder den Dino waschen. Der Apfel gibt 1 AP (5 Min Cooldown). Beim Spielen mit dem Ball (1 Min Cooldown) besteht die Chance auf 1 AP. Das Waschen gibt 50 XP (10 Min Cooldown)."/>
                
                <TextBlock FontWeight="SemiBold" Text="Grabungen &amp; Sammlungen"/>
                <TextBlock Text="Du kannst den Dino über das Dino-Menü zum Graben schicken, wenn du Gebiete freigeschaltet hast. Dabei findet er Toys und Skins, die du ihm anziehen kannst!"/>
                
                <TextBlock FontWeight="SemiBold" Text="Einstellungen &amp; Profile"/>
                <TextBlock Text="Im Dino-Menü findest du ganz unten die Knöpfe für Profile und Einstellungen. Dort kannst du anpassen, wie groß der Dino sein soll, ob er herumlaufen darf und vieles mehr."/>
            </StackPanel>
        </ScrollViewer>
        
        <Button Grid.Row="2" Content="Alles klar!" Height="35" Click="Close_Click"
                Background="#3B9272" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>


