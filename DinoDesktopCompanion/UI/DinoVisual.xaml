<UserControl x:Class="DinoDesktopCompanion.UI.DinoVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="200" Height="120" Background="Transparent">
    <Grid x:Name="FacingRoot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="FacingTransform" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Image x:Name="SpriteImage" Stretch="Uniform" SnapsToDevicePixels="True" Visibility="Collapsed"/>
        <Grid x:Name="SkinOverlaysGrid" Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle x:Name="SkinBaseOverlay"/>
            <Rectangle x:Name="SkinGradientOverlay"/>
            <Rectangle x:Name="SkinPatternOverlay"/>
            <Canvas x:Name="SkinParticleCanvas"/>
            <Rectangle x:Name="SkinGlowOverlay"/>
        </Grid>
        <Canvas x:Name="AccessoryCanvas" Visibility="Collapsed" IsHitTestVisible="False">
            <Image x:Name="BackAccImage" Width="100" Height="100" Canvas.Left="50" Canvas.Top="50"/>
            <Image x:Name="NeckAccImage" Width="100" Height="100" Canvas.Left="50" Canvas.Top="50"/>
            <Image x:Name="HeadAccImage" Width="100" Height="100" Canvas.Left="50" Canvas.Top="50"/>
            <Image x:Name="FaceAccImage" Width="100" Height="100" Canvas.Left="50" Canvas.Top="50"/>
        </Canvas>

    </Grid>
</UserControl>
