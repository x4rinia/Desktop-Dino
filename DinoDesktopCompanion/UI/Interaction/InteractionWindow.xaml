<Window x:Class="DinoDesktopCompanion.UI.InteractionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DinoDesktopCompanion.UI"
        Title="Dino Menü" Width="1100" Height="700"
        MinWidth="1100" MaxWidth="1100" MinHeight="700" MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DinoSurface}"
        Foreground="{StaticResource DinoText}"
        ShowInTaskbar="True" Topmost="False" ResizeMode="NoResize" SizeToContent="Manual">
    <Window.Resources>
        <!-- Style for Navigation Buttons (RadioButtons looking like flat buttons) -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DinoText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DinoPrimary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource DinoButton}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HomeSlotButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="Background" Value="#66342F2C"/>
            <Setter Property="BorderBrush" Value="#B3FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SlotChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SlotChrome" Property="Background" Value="#88483F39"/>
                                <Setter TargetName="SlotChrome" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SlotChrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Background="{StaticResource DinoHeaderGradient}" BorderBrush="{StaticResource DinoBorder}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="White" BorderBrush="{StaticResource DinoBorder}" BorderThickness="2" Margin="0,0,15,0">
                        <TextBlock Text="🦕" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dino Menü" FontWeight="Bold" FontSize="20" Foreground="{StaticResource DinoPrimaryDark}"/>
                        <TextBlock Text="Dein kleiner Desktop-Begleiter" FontSize="12" Foreground="{StaticResource DinoMutedText}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="17" Padding="12,7" Margin="4" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="★  Level " FontSize="13" FontWeight="Bold" Foreground="#D99A00"/>
                            <TextBlock x:Name="LevelText" Text="1" FontSize="13" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="17" Padding="12,7" Margin="4" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1" MinWidth="140">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="XP" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DinoMutedText}"/>
                                <TextBlock Grid.Column="1" x:Name="XpText" Text="0 / 100" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="XpBar" Height="8" Margin="0,3,0,0" Value="0" Maximum="100" Foreground="{StaticResource DinoPrimary}" Background="#E0E0E0" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="17" Padding="12,7" Margin="4" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Coins  " FontSize="13" FontWeight="Bold" Foreground="#B77B00"/>
                            <TextBlock x:Name="CoinsText" Text="0" FontSize="13" FontWeight="Bold" Foreground="#E5A010"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="17" Padding="12,7" Margin="4" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AP  " FontSize="13" FontWeight="Bold" Foreground="#2879BF"/>
                            <TextBlock x:Name="ApText" Text="10 / 10" FontSize="13" FontWeight="Bold" Foreground="#2A82D6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 2. LINKSNAVIGATION -->
            <Border Grid.Column="0" Background="{StaticResource DinoSurface}" BorderBrush="{StaticResource DinoBorder}" BorderThickness="0,0,1,0" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <RadioButton Content="Übersicht" Style="{StaticResource NavButton}" IsChecked="True" Checked="Nav_Start_Checked"/>
                        <RadioButton Content="Schlafen / Aufwecken" Style="{StaticResource NavButton}" Checked="Nav_Sleep_Checked"/>
                        <RadioButton Content="Abenteuer" Style="{StaticResource NavButton}" Checked="Nav_Adventure_Checked"/>
                        <RadioButton Content="Garderobe" Style="{StaticResource NavButton}" Checked="Nav_Garderobe_Checked"/>
                        <RadioButton Content="Sammelalbum" Style="{StaticResource NavButton}" Checked="Nav_Toys_Checked"/>
                        <RadioButton Content="Erfolge" Style="{StaticResource NavButton}" Checked="Nav_Achievements_Checked"/>
                        <RadioButton Content="Dinohaus" Style="{StaticResource NavButton}" Checked="Nav_Home_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 4. MITTELBEREICH (CONTENT) -->
            <Grid Grid.Column="1" Background="{StaticResource DinoBackground}">
                <!-- Start / Dashboard -->
                <Grid x:Name="PanelStart" Visibility="Visible" ClipToBounds="True">
                    <Image x:Name="OverviewBackgroundImage" Stretch="UniformToFill"/>
                    <Border Background="#32FFFFFF"/>
                    <Grid Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#EEFFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1"
                                CornerRadius="15" Padding="16,11" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Willkommen bei deinem Dino" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                                <TextBlock Text="Was möchtet ihr heute gemeinsam erleben?" Foreground="{StaticResource DinoMutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#E6F7FBF9" BorderBrush="#BFD5E5DF" BorderThickness="1"
                                    CornerRadius="17" Padding="14" Margin="0,0,12,0">
                                <Grid>
                                    <ui:DinoVisual x:Name="PreviewDino" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Width="280" Height="280"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="#F2FFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1"
                                    CornerRadius="17" Padding="18">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Dein Dino" FontWeight="Bold" FontSize="21" Foreground="{StaticResource DinoPrimaryDark}" Margin="0,0,0,14"/>
                                    <TextBlock Text="Profil" FontSize="11" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="ProfileNameText" Text="Mein Dino" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock Text="Name" FontSize="11" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="DinoNameText" Text="Dino" FontWeight="Bold" FontSize="17" Margin="0,0,0,10"/>
                                    <TextBlock Text="Geburtstag" FontSize="11" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="BirthdayText" Text="Nicht angegeben" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock Text="Aktueller Zustand" FontSize="11" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="StateText" Text="Idle" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock Text="Ausgerüsteter Skin" FontSize="11" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="SkinText" Text="Standard" FontWeight="SemiBold" Foreground="{StaticResource DinoPrimaryDark}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Background="#F2FFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1"
                                CornerRadius="15" Padding="14,10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Statistik" FontSize="17" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                                <TextBlock x:Name="StatsText" Text="Wird geladen..." TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource DinoText}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Schlafen / Aufwecken -->
                <Grid x:Name="PanelSleep" Visibility="Collapsed" ClipToBounds="True">
                    <Image x:Name="SleepBackgroundImage" Stretch="UniformToFill" Opacity="0.38"/>
                    <Border Background="#A8FFFFFF"/>
                    <ScrollViewer Margin="22" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#F2FFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Schlafen / Aufwecken" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                                    <TextBlock Text="AP regenerieren nur, während Dino schläft." Foreground="{StaticResource DinoMutedText}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F4FFFFFF" BorderBrush="#D4E6DF" BorderThickness="1" CornerRadius="16" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Status" FontSize="11" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="SleepStatusText" Text="Wach" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}" Margin="0,0,0,14"/>
                                    <TextBlock Text="AP" FontSize="11" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="SleepApText" Text="10 / 10" FontSize="18" FontWeight="Bold" Foreground="#2A82D6" Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Nächster AP" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SleepRegenProgressText" Text="0 %" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="SleepRegenProgressBar" Height="12" Minimum="0" Maximum="100" Value="0"
                                                 Foreground="{StaticResource DinoPrimary}" Background="#E2ECE9" BorderThickness="0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                        <Button x:Name="SleepDinoButton" Content="Dino schlafen schicken" Width="190" Margin="0,0,10,0" Click="SleepDino_Click"/>
                                        <Button x:Name="WakeDinoButton" Content="Dino aufwecken" Width="160" Click="WakeDino_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Shop -->
                <ScrollViewer x:Name="PanelShop" Margin="20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Shop" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}" Margin="0,0,0,20"/>
                        <WrapPanel x:Name="ShopList" Orientation="Horizontal"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Garderobe -->
                <Grid x:Name="PanelGarderobe" Visibility="Collapsed" ClipToBounds="True">
                    <Image x:Name="WardrobeBackgroundImage" Stretch="UniformToFill"/>
                    <Border Background="#66FFFFFF"/>
                    
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Links: Anprobe (Spiegel) -->
                        <Border Grid.Column="0" Background="#F4FFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1"
                                CornerRadius="17" Padding="14" Margin="0 0 14 0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ankleidezimmer" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}" HorizontalAlignment="Center"/>
                                <Grid Height="240" Margin="0 15 0 15">
                                    <ui:DinoVisual x:Name="WardrobeDino" Width="220" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock x:Name="WardrobePreviewName" Text="Standard Skin" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource DinoPrimaryDark}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WardrobePreviewStatus" Text="Ausgerüstet" FontSize="13" Foreground="{StaticResource DinoMutedText}" HorizontalAlignment="Center" Margin="0 5 0 15"/>
                                <Button x:Name="WardrobeEquipButton" Content="Jetzt ausrüsten" Height="38" Click="WardrobeEquipButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Rechts: Skin-Liste -->
                        <Border Grid.Column="1" Background="#EFFFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1" CornerRadius="16" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="SkinsList" Orientation="Horizontal" HorizontalAlignment="Left"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Sammelalbum -->
                <Grid x:Name="PanelToys" Margin="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E8F7F3" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1"
                            CornerRadius="13" Padding="13,9" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Sammelalbum" FontSize="25" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                            <TextBlock Text="Dinos besondere Fundstücke aus allen Abenteuern."
                                       FontSize="11" Foreground="{StaticResource DinoMutedText}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="10,7" Margin="0,0,0,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Gebiet" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="AlbumAreaFilter" Width="115" Height="29" Margin="0,0,12,0"/>
                            <TextBlock Text="Seltenheit" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="AlbumRarityFilter" Width="130" Height="29"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F7FBF9" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1"
                                CornerRadius="13" Padding="5" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="ToysList" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1"
                                CornerRadius="13" Padding="11">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border x:Name="AlbumDetailPreviewBorder" Height="118" CornerRadius="11" Background="#EDF3F1"
                                            BorderBrush="{StaticResource DinoBorder}" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Image x:Name="AlbumDetailImage" Stretch="Uniform" Margin="8"/>
                                            <TextBlock x:Name="AlbumDetailGlyph" Text="?" FontSize="48" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="AlbumDetailName" Text="Fundstück wählen" FontWeight="Bold" FontSize="16"
                                               Foreground="{StaticResource DinoPrimaryDark}" TextWrapping="Wrap" Margin="0,10,0,5"/>
                                    <Border x:Name="AlbumDetailRarityBadge" Background="#EEF2F1" CornerRadius="9"
                                            HorizontalAlignment="Left" Padding="7,3" Margin="0,0,0,9">
                                        <TextBlock x:Name="AlbumDetailRarityText" Text="Seltenheit" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock x:Name="AlbumDetailDescription" Text="Wähle links einen Albumplatz aus."
                                               TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource DinoMutedText}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Fundort" FontSize="10" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="AlbumDetailAreaText" Text="–" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <TextBlock Text="Erstmals gefunden" FontSize="10" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="AlbumDetailFoundAtText" Text="–" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                    <TextBlock Text="Status" FontSize="10" Foreground="{StaticResource DinoMutedText}"/>
                                    <TextBlock x:Name="AlbumDetailStatusText" Text="Nicht entdeckt" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="11,8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AlbumProgressText" Text="0 / 0 entdeckt" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="AlbumProgressBar" Grid.Column="1" Height="10" Maximum="100" Margin="12,0"
                                         Foreground="{StaticResource DinoPrimary}" Background="#E2ECE9" BorderThickness="0"/>
                            <TextBlock x:Name="AlbumProgressPercent" Grid.Column="2" Text="0 %" FontWeight="Bold"
                                       Foreground="{StaticResource DinoPrimaryDark}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>


                <!-- Erfolge -->
                <Grid x:Name="PanelAchievements" Visibility="Collapsed" ClipToBounds="True">
                    <Image x:Name="AchievementsBackgroundImage" Stretch="UniformToFill" Opacity="0.34"/>
                    <Border Background="#A8F7FBF9"/>
                    <ScrollViewer Margin="22" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#F2FFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1" CornerRadius="16" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" CornerRadius="29" Background="#FFF2C8">
                                        <TextBlock Text="★" FontSize="30" Foreground="#E5A010" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Dinos Erfolge" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                                        <TextBlock Text="Jedes Abenteuer, jeder Fund und jedes Spiel bringt euch ein Stück weiter."
                                                   Foreground="{StaticResource DinoMutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="#F2FFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="AchievementsTotalText" Text="Gesamtfortschritt: 0 / 0" FontWeight="Bold" FontSize="14" Foreground="{StaticResource DinoPrimaryDark}"/>
                                    <ProgressBar x:Name="AchievementsTotalBar" Height="10" Minimum="0" Maximum="100" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Content="Alle" x:Name="FilterAll" GroupName="AchievementFilter" IsChecked="True" Style="{StaticResource NavButton}" Margin="0,0,5,0" Checked="AchievementFilter_Checked"/>
                                <RadioButton Content="Abenteuer" x:Name="FilterAdventure" GroupName="AchievementFilter" Style="{StaticResource NavButton}" Margin="0,0,5,0" Checked="AchievementFilter_Checked"/>
                                <RadioButton Content="Sammeln" x:Name="FilterCollect" GroupName="AchievementFilter" Style="{StaticResource NavButton}" Margin="0,0,5,0" Checked="AchievementFilter_Checked"/>
                                <RadioButton Content="Zuhause" x:Name="FilterHome" GroupName="AchievementFilter" Style="{StaticResource NavButton}" Checked="AchievementFilter_Checked"/>
                            </StackPanel>

                            <Border Background="#F2FFFFFF" BorderBrush="#D4E6DF" BorderThickness="1" CornerRadius="15" Padding="14">
                                <StackPanel x:Name="AchievementsList"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Abenteuer: Gebiet wählen und Desktop-Ausgrabungen -->
                <Grid x:Name="PanelAdventure" Visibility="Collapsed" ClipToBounds="True">
                    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#F0FFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1"
                                    CornerRadius="15" Padding="16,11" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Abenteuer" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                                    <TextBlock Text="Wähle ein Gebiet für Dinos nächste Entdeckungstour."
                                               Foreground="{StaticResource DinoMutedText}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#BFD5E5DF" BorderThickness="1" CornerRadius="16"
                                    ClipToBounds="True" Margin="0,0,0,10">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="806" Height="330">
                                        <Image x:Name="AdventureBackgroundImage" Stretch="UniformToFill"/>
                                        <Canvas x:Name="AreasList" Width="806" Height="330"/>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <Border Background="#F2FFFFFF" BorderBrush="#BFD5E5DF" BorderThickness="1"
                                    CornerRadius="16" Padding="15">
                                <StackPanel>
                                    <StackPanel x:Name="AdventureAreaDetails" Visibility="Collapsed">
                                        <TextBlock x:Name="SelectedAreaTitle" FontSize="21" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                                        <TextBlock x:Name="SelectedAreaLevel" FontSize="12" Foreground="{StaticResource DinoMutedText}" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="SelectedAreaDescription" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <Border x:Name="DiggingPanel" Style="{StaticResource DinoSectionCard}">
                                            <StackPanel>
                                                <TextBlock x:Name="DiggingInfoText" TextWrapping="Wrap"/>
                                                <Button x:Name="DisableAreaButton" Content="Gebiet deaktivieren"
                                                        HorizontalAlignment="Left" Margin="0,9,0,0"
                                                        Click="DisableArea_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>


                <Grid x:Name="PanelHome" Margin="14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dinohaus" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                            <TextBlock Text="Richte Dinos Zuhause ein und mache es noch gemütlicher!"
                                       FontSize="11" Foreground="{StaticResource DinoMutedText}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="HomeActiveBonusesText" Text="Haus-Boni aktiv: keine"
                                       FontSize="10" Foreground="{StaticResource DinoPrimaryDark}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1"
                                CornerRadius="11" Padding="10,7" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="HomeProgressText" Text="0 / 0 eingerichtet" FontSize="11" FontWeight="SemiBold"/>
                                <Grid Margin="0,5,0,0">
                                    <ProgressBar x:Name="HomeProgressBar" Height="9" Maximum="100" BorderThickness="0"
                                                 Foreground="{StaticResource DinoPrimary}" Background="#E6E9E8"/>
                                    <TextBlock x:Name="HomeProgressPercent" HorizontalAlignment="Right" Margin="0,-3,0,0"
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource DinoPrimaryDark}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource DinoCard}" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1"
                            CornerRadius="14" ClipToBounds="True">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <Grid x:Name="HomeCanvasContainer" Width="806" Height="365" ClipToBounds="True">
                                <Image x:Name="HomeBackgroundImage" Width="806" Height="365" Stretch="Fill"/>
                                <Canvas x:Name="HomeCanvas" Width="806" Height="365"/>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource DinoBorder}" BorderThickness="1"
                            CornerRadius="13" Padding="10" Margin="0,10,0,0">
                        <Grid Height="78">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource DinoBackground}" CornerRadius="10" Margin="0,0,10,0" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="HomeSelectionPreview" Stretch="Uniform" Margin="5"/>
                                    <TextBlock x:Name="HomeSelectionPlaceholder" Text="🔒" FontSize="25" Opacity="0.58"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="HomeSelectionName" Text="Einrichtungsplatz" FontWeight="Bold" FontSize="14"/>
                                <TextBlock x:Name="HomeSelectionDescription" Text="Wähle ein Element direkt im Raum aus."
                                           Foreground="{StaticResource DinoMutedText}" FontSize="11" TextWrapping="Wrap" MaxHeight="30"/>
                                <TextBlock x:Name="HomeSelectionBonus" Foreground="{StaticResource DinoPrimaryDark}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="HomeEquipButton" Grid.Column="2" Content="Ausrüsten" Width="104" MinWidth="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
