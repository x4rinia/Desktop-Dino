<Window x:Class="DinoDesktopCompanion.UI.Interaction.FeedGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dino füttern" Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource DinoBackground}"
        ShowInTaskbar="False">
    <Grid>
        <TextBlock x:Name="InstructionText" Text="Fange 3 Äpfel!" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DinoPrimary}" HorizontalAlignment="Center" Margin="10"/>
        <Canvas x:Name="GameCanvas" MouseMove="GameCanvas_MouseMove">
            <Rectangle x:Name="Mouth" Width="60" Height="20" Fill="{StaticResource DinoPrimaryDark}" Canvas.Bottom="10"/>
        </Canvas>
    </Grid>
</Window>
