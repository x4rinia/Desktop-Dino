<Window x:Class="DinoDesktopCompanion.UI.Interaction.BallGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ball spielen" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource DinoBackground}"
        ShowInTaskbar="False">
    <Grid>
        <TextBlock x:Name="ScoreText" Text="Klicke den Ball 5 Mal!" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DinoPrimary}" HorizontalAlignment="Center" Margin="10"/>
        <Canvas x:Name="GameCanvas">
            <Ellipse x:Name="Ball" Width="70" Height="70" Fill="{StaticResource DinoAccent}" Cursor="Hand" MouseLeftButtonDown="Ball_Click"/>
        </Canvas>
    </Grid>
</Window>
